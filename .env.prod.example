# ============================================================================
# Production environment — single DigitalOcean droplet
# ----------------------------------------------------------------------------
# Copy to `.env.prod` on the droplet at /srv/clubhub/.env.prod and `chmod 600` it.
# `.env.prod` is git-ignored and must stay that way: it holds the JWT signing key,
# the Postgres password and the R2 credentials in plaintext.
#
# Read by docker-compose.prod.yml (db credentials + web build args) and passed
# wholesale into the api container via env_file.
# Full runbook: docs/DEPLOYMENT.md
# ============================================================================

# ─── Database (also consumed by the `db` service itself) ────────────────────
POSTGRES_USER=clubhub
POSTGRES_DB=clubhub
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Host `db` is the compose service name. No sslmode: this never leaves the
# compose network (the db service publishes no ports).
DATABASE_URL=postgresql+psycopg://clubhub:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/clubhub

# ─── Core ───────────────────────────────────────────────────────────────────
# Keeps the JWT-secret startup guard armed. Never true here.
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# BOTH the app and `alembic upgrade head` refuse to start without a real value —
# alembic/env.py imports app.core.config, so a bad secret fails the migration too.
JWT_SECRET_KEY=

# ─── Auth / CORS ────────────────────────────────────────────────────────────
# Required over HTTPS or the browser drops the refresh cookie.
COOKIE_SECURE=true

# EXACTLY the app origin — one entry, no trailing slash. Not the apex: the landing
# page is a separate static site that makes zero API calls, so it must not be an
# allowed origin.
#
# app.<domain> and api.<domain> share the registrable domain <domain>, which makes
# them same-site. That is what lets the refresh cookie keep SameSite=Lax with no
# code change. Splitting them across unrelated hosts (*.vercel.app + *.onrender.com)
# would break sessions on every page reload. See docs/adr/0002.
CORS_ORIGINS=https://app.example.me

# ─── Google sign-in ─────────────────────────────────────────────────────────
# The same OAuth web client ID also goes in NEXT_PUBLIC_GOOGLE_CLIENT_ID below.
# Add https://app.<domain> to the client's Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Media storage — Cloudflare R2 ──────────────────────────────────────────
STORAGE_BACKEND=s3
S3_BUCKET=clubhub-media
# R2 requires the literal "auto".
S3_REGION=auto
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# MUST be a hostname you own. This URL is written verbatim into users.avatar_url and
# is never rewritten, so pointing it at a provider hostname (*.r2.dev) makes the
# storage backend a one-way door — every stored avatar 404s if you ever move. Bind
# media.<domain> to the bucket as an R2 custom domain instead. See docs/adr/0004.
S3_PUBLIC_BASE_URL=https://media.example.me

# R2 API token (Object Read & Write, scoped to the bucket). boto3 reads these
# straight from the environment; they are deliberately not modelled in Settings.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Uncomment if avatar uploads start failing with an opaque R2 error: botocore >= 1.36
# sends default integrity checksums that some S3-compatible stores reject.
# AWS_REQUEST_CHECKSUM_CALCULATION=when_required
# AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

# ─── Frontend build args (inlined at BUILD time by docker-compose.prod.yml) ──
# Changing any of these needs `up -d --build`, not a restart.
NEXT_PUBLIC_API_URL=https://api.example.me
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_LANDING_URL=https://example.me

# ─── Set in the Cloudflare Pages project, NOT here ──────────────────────────
#   NEXT_PUBLIC_APP_URL=https://app.example.me
#   NEXT_PUBLIC_SITE_URL=https://example.me
#   NODE_VERSION=20
